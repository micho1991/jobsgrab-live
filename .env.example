# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (root, used by the Supabase CLI) and fill in.
# App-specific .env files for apps/web and apps/mobile come in Stage 2 / 5.
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Supabase (Dashboard → Project Settings → API). Local values print on `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only. Never expose to a browser or mobile app.

# ── Edge Function secrets (supabase/functions/.env locally; `supabase secrets set` in prod)
RESEND_API_KEY=re_xxxxxxxx         # leave empty locally to log emails instead of sending
EMAIL_FROM="Acme Careers <careers@mail.yourcompany.com>"
EMAIL_REPLY_TO=hr@yourcompany.com
EMAIL_WORKER_SECRET=               # generate: openssl rand -hex 32
APP_URL=http://localhost:3000
COMPANY_NAME=Acme
APP_TIMEZONE=Europe/Skopje
