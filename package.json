{
  "name": "hr-recruit",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -q -o /dev/null -f supabase/tests/security_test.sql",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "test": "tests/harness/run-all.sh",
    "test:db": "tests/harness/db-test.sh"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "turbo": "^2.1.0",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0"
    }
  }
}
